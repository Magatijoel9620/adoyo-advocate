+
+
+/* Block C — restore original light palette, rounded controls and improve cursor feedback */
+:root:not([data-theme="dark"]) {
+  --ink: #242723;
+  --deep: #1d2422;
+  --deep2: #2a312d;
+  --paper: #f2efe7;
+  --white: #faf8f2;
+  --gold: #c3a16b;
+  --gold2: #ddc79f;
+  --muted: #73776f;
+  --line: rgba(36, 39, 35, 0.17);
+  --color-text: #242723;
+  --color-text-muted: #73776f;
+  --color-surface: #f2efe7;
+  --color-surface-raised: #faf8f2;
+  --color-border: rgba(36, 39, 35, 0.17);
+}
+
+/* Keep the site's original rounded-pill action language consistent. */
+button,
+.button,
+a.button,
+.header-cta,
+.mobile-nav-cta,
+.floating-contact,
+.finder-result-actions a {
+  border-radius: 999px;
+}
+.finder-option {
+  border-radius: 16px;
+}
+.finder-whatsapp-cta {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  min-height: 46px;
+  padding: 12px 21px;
+  background: #25d366;
+  color: #10251a !important;
+  font-size: 12px !important;
+  font-weight: 800 !important;
+  text-decoration: none !important;
+  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.14);
+  transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
+}
+.finder-whatsapp-cta:hover {
+  transform: translateY(-2px);
+  background: #49df80;
+  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
+}
+.finder-form-link {
+  color: rgba(250, 248, 242, 0.82) !important;
+  text-decoration: none !important;
+}
+.finder-form-link span {
+  color: var(--brand-brass-soft);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+
+/* A restrained cursor glow: ambient light, not a full-screen flashlight effect. */
+.cursor-glow {
+  position: fixed;
+  top: 0;
+  left: 0;
+  width: 190px;
+  height: 190px;
+  margin: -95px 0 0 -95px;
+  border-radius: 50%;
+  pointer-events: none;
+  z-index: 9998;
+  opacity: 0.2;
+  background: radial-gradient(circle, rgba(209, 173, 114, 0.23) 0%, rgba(118, 169, 160, 0.11) 32%, rgba(118, 169, 160, 0) 72%);
+  mix-blend-mode: screen;
+  will-change: transform;
+  transition: opacity 0.25s ease;
+}
+.cursor-glow.cursor-active { opacity: 0.34; }
+:root[data-theme="dark"] .cursor-glow {
+  background: radial-gradient(circle, rgba(227, 201, 156, 0.28) 0%, rgba(118, 169, 160, 0.16) 34%, rgba(118, 169, 160, 0) 72%);
+  opacity: 0.26;
+}
+@media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
+  .cursor-glow { display: none; }
+}
+@media (max-width: 760px) {
+  .finder-result-actions { align-items: stretch; }
+  .finder-whatsapp-cta { width: 100%; }
+}
